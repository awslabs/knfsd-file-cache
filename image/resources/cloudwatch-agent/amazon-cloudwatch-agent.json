{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log",
            "log_group_name": "knfsd/logs/aws/cloudwatch/agent",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/amazon/ssm/amazon-ssm-agent.log",
            "log_group_name": "knfsd/logs/aws/ssm/agent",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/amazon/ssm/errors.log",
            "log_group_name": "knfsd/logs/aws/ssm/errors",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "knfsd/logs/aws/cloud-init-output",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "knfsd/logs/os/syslog",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/auth.log",
            "log_group_name": "knfsd/logs/os/auth",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/kern.log",
            "log_group_name": "knfsd/logs/os/kern",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "knfsd/ec2",
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_active",
          "cpu_usage_iowait"
        ]
      },
      "disk": {
        "measurement": [
          "disk_free",
          "disk_used_percent"
        ],
        "drop_device": true,
        "resources": [
          "/",
          "/var/cache/fscache"
        ]
      },
      "diskio": {
        "measurement": [
          "diskio_write_bytes",
          "diskio_read_bytes",
          "diskio_reads",
          "diskio_writes",
          "diskio_io_time",
          "diskio_ebs_ec2_instance_performance_exceeded_iops",
          "diskio_ebs_ec2_instance_performance_exceeded_tp",
          "diskio_ebs_volume_queue_length",
          "diskio_instance_store_performance_exceeded_iops",
          "diskio_instance_store_performance_exceeded_tp",
          "diskio_instance_store_volume_queue_length"
        ],
        "resources": [
          "*"
        ],
        "metrics_collection_interval": 30
      },
      "ethtool": {
        "metrics_include": [
          "bw_in_allowance_exceeded",
          "bw_out_allowance_exceeded",
          "conntrack_allowance_exceeded",
          "linklocal_allowance_exceeded",
          "pps_allowance_exceeded"
        ]
      },
      "mem": {
        "measurement": [
          "mem_cached",
          "mem_buffered",
          "mem_used_percent"
        ]
      },
      "net": {
        "measurement": [
          "net_bytes_recv",
          "net_bytes_sent",
          "net_drop_in",
          "net_drop_out",
          "net_err_in",
          "net_err_out"
        ],
        "resources": [
          "ens*"
        ]
      },
      "netstat": {
        "measurement": [
          "netstat_tcp_close_wait",
          "netstat_tcp_established",
          "netstat_tcp_listen",
          "netstat_tcp_syn_sent",
          "netstat_tcp_time_wait",
          "netstat_udp_socket"
        ]
      },
      "processes": {
        "measurement": [
          "processes_blocked",
          "processes_stopped",
          "processes_total",
          "processes_total_threads",
          "processes_zombies"
        ]
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ]
      }
    }
  }
}
