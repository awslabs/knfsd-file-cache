{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log",
            "log_group_name": "knfsd/amazon-cloudwatch-agent.log",
            "log_stream_name": "cloudwatch-agent-{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/amazon/ssm/amazon-ssm-agent.log",
            "log_group_name": "knfsd/ssm/amazon-ssm-agent.log",
            "log_stream_name": "amazon-ssm-agent-{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/amazon/ssm/errors.log",
            "log_group_name": "knfsd/ssm/errors.log",
            "log_stream_name": "amazon-ssm-errors-{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "knfsd/cloud-init-output.log",
            "log_stream_name": "cloud-init-output-{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "knfsd/syslog",
            "log_stream_name": "syslog-{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/auth.log",
            "log_group_name": "knfsd/auth.log",
            "log_stream_name": "auth-{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/kern.log",
            "log_group_name": "knfsd/kern.log",
            "log_stream_name": "kern-{instance_id}",
            "retention_in_days": 30
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "knfsd/ec2",
    "aggregation_dimensions": [
      [
        "InstanceId"
      ]
    ],
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_active",
          "cpu_usage_iowait"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "*"
        ],
        "totalcpu": false
      },
      "disk": {
        "measurement": [
          "disk_free",
          "disk_total",
          "disk_used",
          "disk_used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/",
          "/var/cache/fscache"
        ]
      },
      "diskio": {
        "measurement": [
          "diskio_io_time",
          "diskio_write_bytes",
          "diskio_read_bytes"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "*"
        ]
      },
      "ethtool": {
        "metrics_include": [
          "bw_in_allowance_exceeded",
          "bw_out_allowance_exceeded",
          "conntrack_allowance_exceeded",
          "linklocal_allowance_exceeded",
          "pps_allowance_exceeded",
          "conntrack_allowance_available"
        ]
      },
      "mem": {
        "measurement": [
          "mem_total",
          "mem_cached",
          "mem_buffered",
          "mem_free",
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "net": {
        "measurement": [
          "net_bytes_recv",
          "net_bytes_sent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "*"
        ]
      },
      "netstat": {
        "measurement": [
          "netstat_tcp_established",
          "netstat_tcp_time_wait"
        ],
        "metrics_collection_interval": 60
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
