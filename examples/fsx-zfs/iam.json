{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KnfsdFsxOpenZfs",
      "Effect": "Allow",
      "Action": [
        "fsx:CreateFileSystem",
        "fsx:DeleteFileSystem",
        "fsx:DescribeFileSystems",
        "fsx:DescribeVolumes",
        "fsx:ListTagsForResource",
        "fsx:TagResource",
        "fsx:UntagResource",
        "fsx:UpdateFileSystem",
        "fsx:UpdateVolume"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KnfsdFsxServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/fsx.amazonaws.com/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "fsx.amazonaws.com"
        }
      }
    }
  ]
}
