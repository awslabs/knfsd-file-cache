{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KnfsdS3Files",
      "Effect": "Allow",
      "Action": "s3files:*",
      "Resource": "*"
    },
    {
      "Sid": "KnfsdS3FilesEc2Networking",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeNetworkInterfaceAttribute",
        "ec2:ModifyNetworkInterfaceAttribute"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KnfsdS3FilesPassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/knfsd-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "elasticfilesystem.amazonaws.com"
        }
      }
    },
    {
      "Sid": "KnfsdS3FilesServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/elasticfilesystem.amazonaws.com/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "elasticfilesystem.amazonaws.com"
        }
      }
    },
    {
      "Sid": "KnfsdS3Bucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLogging",
        "s3:GetBucketNotification",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:PutBucketNotification",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::knfsd-*"
    },
    {
      "Sid": "KnfsdS3Object",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::knfsd-*/*"
    },
    {
      "Sid": "KnfsdS3FilesEventBridgeRead",
      "Effect": "Allow",
      "Action": [
        "events:DescribeRule",
        "events:ListRules",
        "events:ListTargetsByRule"
      ],
      "Resource": "arn:aws:events:*:*:rule/*"
    },
    {
      "Sid": "KnfsdS3FilesEventBridgeManage",
      "Effect": "Allow",
      "Action": [
        "events:DeleteRule",
        "events:PutRule",
        "events:PutTargets",
        "events:RemoveTargets"
      ],
      "Resource": "arn:aws:events:*:*:rule/DO-NOT-DELETE-S3-Files*",
      "Condition": {
        "StringEquals": {
          "events:ManagedBy": "elasticfilesystem.amazonaws.com"
        }
      }
    }
  ]
}
