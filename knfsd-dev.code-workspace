          "command": "powershell",
        },
        "osx": {
          "command": "/bin/bash",
          "args": [ "-il" ]
        },
        "linux": {
          "command": "/usr/bin/bash",
          "args": [ "-il" ]
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "isBackground": true,
        "problemMatcher": [],
